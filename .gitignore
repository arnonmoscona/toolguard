# .claude is a SYMLINK into the dot_files repo, where its contents are version
# controlled (claude/projects/toolguard/.claude). Git cannot descend a symlink
# -- "pathspec is beyond a symbolic link" -- so no negation pattern can
# re-include anything under it. The earlier attempt to track
# .claude/commands/documentation-review.md that way is therefore impossible
# here, and that file is now tracked in dot_files only (TOO-19, 2026-07-28).
.claude
logs
.mcp.json
.DS_Store
.idea/
tmp/

# Coverage artifacts (tools/coverage_stdlib.py)
.coverage
cover/
.tokensave
# Added by code-review-graph
.code-review-graph/

# code-review-graph installer noise: instruction/skill files generated for other
# AI platforms we do not use (Claude Code reads CLAUDE.md, not these). They
# regenerate whenever `code-review-graph install` runs, so keep them out of git.
.cursorrules
.windsurfrules
.opencode.json
.gemini/
GEMINI.md
.kiro/
.qoder/
QODER.md
.github/code-review-graph.instruction.md
skills/debug-issue/
skills/explore-codebase/
skills/refactor-safely/
skills/review-changes/
.pyscn/
