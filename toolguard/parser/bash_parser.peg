# Canopy PEG Grammar for Bash Command Parsing
# Identifies commands, file read operations, and file write operations
#
# Usage: canopy bash_parser.peg --lang python
#   (from the toolguard/parser directory using npx canopy@latest)
#
# TOO-17: Grammar extended to handle multi-line commands.
# See design doc: toolguard-memories/TOO-17/TOO-17 Multi-line Bash Bypass Fix.md
#
# DESIGN CONSTRAINT (hard, non-negotiable):
# ALL structural parsing (statement splitting, pipe splitting, control-structure
# recognition, quoting) happens HERE. Only a narrow lexical pre-pass
# (CRLF normalisation, backslash-join, heredoc body removal, comment strip,
# whitespace collapse) runs before the grammar. No hand-rolled bash parsing.

grammar BashParser

# ============================================================================
# Top-level rule: a multi-statement program
#
# A "program" is one or more statements separated by statement separators
# (newlines and/or semicolons).  Leading and trailing line_ws (which includes
# blank lines, inline comments) is consumed.  This replaces the old
# `command_line <- spacing compound_command spacing` single-statement rule.
#
# The top-level node exposes:
#   .compound_command  -- the first statement node (label chosen so that
#                         existing consumers of tree.compound_command work
#                         without any manual shim in the generated file)
#   .rest_stmts        -- list of (sep, stmt) pairs for subsequent statements
# (Named via TreeNode subclasses generated by canopy.)
# ============================================================================

program <- line_ws compound_command:statement rest_stmts:(statement_sep statement)* line_ws

# A statement is either a shell control structure or a compound command.
# Control structures are tried FIRST (ordered choice) so reserved words
# (for, while, if, case ...) are consumed by the appropriate rule and do not
# reach compound_command where they would cause a parse failure.
statement <- for_loop / while_loop / until_loop / if_stmt / case_stmt / compound_command

# Statement separator: one or more newlines and/or semicolons, with optional
# surrounding horizontal whitespace and inline comments.
# Collapses blank lines and ";\n" combos into a single separator.
statement_sep <- (line_ws_char / ";")+

# ============================================================================
# Line-level whitespace (used between statements and inside control structures)
#
# line_ws absorbs:
#   - horizontal whitespace (spaces, tabs)
#   - newline characters
#   - inline comments (# to end-of-line)
# It is used anywhere where a statement boundary may appear.
# ============================================================================

line_ws <- line_ws_char*

# A single "line whitespace" character or comment.
# Comments are # to end-of-line (at word boundary, enforced by the pre-pass).
line_ws_char <- [ \t\n\r] / comment

# An inline comment: # followed by everything to end of line.
# Note: the pre-pass already strips comments, so this is mainly a safety net
# for any that survive.  Only recognised at word boundaries (start of token
# group) per the pre-pass rules; the grammar treats # as opaque otherwise.
comment <- "#" (![\n] .)*

# ============================================================================
# Compound commands - connected by control operators
#
# This is the same as before, with one extension: after binary operators
# (&&, ||, |) a newline is allowed (trailing-operator line continuation).
# The line_ws in and_op / or_op / pipe absorbs such newlines so that:
#   git status &&
#   rm -rf /
# parses as ONE compound (the newline is continuation, not a separator).
# ============================================================================

# A compound command is pipelines connected by control operators.
# trailing_background / trailing_semicolon handle a trailing & or ; with no
# following pipeline.
compound_command <- pipeline (control_op pipeline)* (trailing_background / trailing_semicolon)?

control_op <- and_op / or_op / semicolon / background

# After && / || / | we absorb line_ws (which includes newlines), making them
# trailing-operator continuations.  This is the key change for multi-line
# operators: `git status &&\nrm -rf /` stays ONE compound.
and_op <- spacing "&&" line_ws
or_op <- spacing "||" line_ws

# Semicolons inside compound_command (between pipelines): horizontal spacing
# only (newlines here would be statement separators at the program level).
semicolon <- spacing ";" spacing
background <- spacing "&" !"&" spacing

# Trailing & / ; at end of a compound (no following pipeline).
trailing_background <- spacing "&" !"&" spacing?
trailing_semicolon <- spacing ";" spacing?

# ============================================================================
# Pipeline - commands connected by pipes
# ============================================================================

pipeline <- pipeline_element (pipe pipeline_element)*

# After | we also allow line_ws (trailing-pipe continuation), matching the
# behaviour of && and ||.
pipe <- spacing "|" !"|" line_ws

pipeline_element <- subshell / brace_group / simple_command

# ============================================================================
# Subshells and brace groups
# ============================================================================

# Subshell: (command) - recursively contains compound commands.
# Note: $(command) is handled as cmd_substitution, not subshell.
subshell <- "(" spacing compound_command spacing ")"

# Brace group: { command; } - recursively contains compound commands.
brace_group <- "{" spacing compound_command spacing "}"

# ============================================================================
# Control structures
#
# TOO-17: Recognise shell control structures so the tree-walker can classify
# them as SIMPLE (decompose inner commands) or COMPLEX (emit ASK).
#
# Grammar strategy:
#   - Each structure is a separate named rule (for_loop, while_loop, etc.).
#   - Bodies may be ; -delimited OR newline-separated (both forms recognised).
#   - else / elif are captured as optional tails so the tree-walker can detect
#     their presence and route to COMPLEX.
#   - We do NOT semantically validate variables, expansions, etc. -- we only
#     need enough structure to extract inner commands for simple cases.
#
# SIMPLE tier (tree-walker decides): non-nested, linear body, no else/elif,
# condition = plain command or POSIX [ ... ] test.
# COMPLEX tier (tree-walker decides): else/elif present, nesting detected,
# [[ ]] / (( )) in condition.
# ============================================================================

# ---------------------------------------------------------------------------
# for loop: for VAR in WORDS; do BODY done
#           for VAR in WORDS (newline) do (newline) BODY (newline) done
#
# for_header captures "VAR in WORDS" -- everything between `for` and the
# semicolon/newline that precedes `do`.  It stops when it encounters `;` or
# when word-matching fails at `do` (because do_kw is in ctrl_keyword and is
# blocked by the !ctrl_keyword lookahead in command_word).
#
# The pre-do separator is: optional ";" + mandatory line_ws (which absorbs
# newlines and blank lines).  For the "do on same line" form the line_ws
# matches zero characters (spacing is already handled by for_header's
# trailing `spacing` per word).
# ---------------------------------------------------------------------------

for_loop <- for_kw spacing for_header (spacing ";" spacing)? line_ws do_clause body_end done_kw

# for_header: consume words stopping before `do` keyword.
# Each word is followed by horizontal spacing; we stop when the next token
# would be `do` (caught by the !do_kw negative lookahead) or when no more
# words remain before `;`.
for_header <- (!do_kw word spacing)*

# while / until loops: condition is a compound_command; `do` terminates it
# because `do` is in ctrl_keyword (blocked in command_word).
# The optional `; ` before `do` and the optional newline are handled the same
# way as for_loop.
while_loop <- while_kw spacing ctrl_condition (spacing ";" spacing)? line_ws do_clause body_end done_kw
until_loop <- until_kw spacing ctrl_condition (spacing ";" spacing)? line_ws do_clause body_end done_kw

# The do...done body.
do_clause <- do_kw line_ws ctrl_body

# ---------------------------------------------------------------------------
# if statement: if COND; then BODY [elif COND then BODY]* [else BODY] fi
#
# The condition is a compound_command; `then` terminates it because `then`
# is in ctrl_keyword.  Same `(spacing ";" spacing)?` trick for the
# `;` before `then`.
# ---------------------------------------------------------------------------

if_stmt <- if_kw spacing ctrl_condition (spacing ";" spacing)? line_ws then_clause elif_clause* else_clause? body_end fi_kw

then_clause <- then_kw line_ws ctrl_body
elif_clause <- body_end elif_kw spacing ctrl_condition (spacing ";" spacing)? line_ws then_kw line_ws ctrl_body
else_clause <- body_end else_kw line_ws ctrl_body

# body_end: separator between the last body statement and the closing keyword.
# May be ";" / newline / whitespace runs, or nothing.
# This handles patterns like: `echo ok; fi` or `echo ok\nfi` or `echo ok fi`
# (the last being unusual but valid when fi is preceded by space).
body_end <- (line_ws_char / ";")*

# ---------------------------------------------------------------------------
# case statement: case WORD in PATTERNS esac
# case is always treated as COMPLEX (never decomposed) because the pattern
# matching syntax is too varied to handle generically.
# ---------------------------------------------------------------------------

case_stmt <- case_kw spacing word spacing in_kw line_ws case_body esac_kw

# Case body: one or more pattern clauses.  We capture it roughly.
case_body <- case_clause*

case_clause <- case_pattern spacing ")" line_ws ctrl_body line_ws ";;" line_ws

case_pattern <- (!(")" / ";;") .)*

# ---------------------------------------------------------------------------
# Shared body rule: a sequence of statements inside a control structure.
# This mirrors the top-level `program` structure so that both `;`-delimited
# and newline-separated bodies parse identically.
# ---------------------------------------------------------------------------

ctrl_body <- ctrl_stmt (ctrl_sep ctrl_stmt)*

# A body statement can itself be a nested control structure.
ctrl_stmt <- for_loop / while_loop / until_loop / if_stmt / case_stmt / compound_command

# Body separator: ; or newline (collapsing runs and blank lines).
ctrl_sep <- (line_ws_char / ";")+

# ---------------------------------------------------------------------------
# Condition: the expression between if/while/until and then/do.
# Parsed as a compound_command; the terminal keywords (`then`, `do`, `elif`,
# `else`, `fi`, `done`) block command_word via ctrl_keyword, so the
# compound_command naturally stops at those keywords.
# ---------------------------------------------------------------------------

ctrl_condition <- compound_command

# ---------------------------------------------------------------------------
# Reserved keywords (block command_word from consuming them)
# ---------------------------------------------------------------------------

# Keyword rules: match the keyword word followed by a non-identifier character
# OR end of input.  The `kw_end` rule handles both cases.
for_kw  <- "for"   kw_end
while_kw <- "while" kw_end
until_kw <- "until" kw_end
if_kw   <- "if"    kw_end
then_kw <- "then"  kw_end
elif_kw <- "elif"  kw_end
else_kw <- "else"  kw_end
fi_kw   <- "fi"    kw_end
case_kw <- "case"  kw_end
in_kw   <- "in"    kw_end
do_kw   <- "do"    kw_end
done_kw <- "done"  kw_end
esac_kw <- "esac"  kw_end

# kw_end: the character immediately after a keyword must be a non-identifier
# character (space, semicolon, newline, etc.) OR we are at end of input.
# This prevents "done" from matching "donemore".
kw_end <- ![a-zA-Z0-9_]

# ============================================================================
# Simple command - single command with redirections and process substitutions
#
# Process substitution <(...) and >(...) appear as ARGUMENTS inside a simple
# command (e.g. `diff <(sort a) <(sort b)`).  They are recognised here so the
# tree-walker can detect them and emit an UndecidableSegment (ASK).
# They must appear BEFORE `redirection` in the ordered choice so that `<(`
# is not consumed as `input_redirect`.
# ============================================================================

simple_command <- command_name (proc_subst / redirection / cmd_substitution / command_arg)*

# <(...) or >(...): process substitution recognised as a simple_command token.
# The tree-walker emits UndecidableSegment(ASK) when it finds one of these.
proc_subst <- ("<" / ">") "(" spacing compound_command spacing ")" spacing

# command_name: how a simple command starts.  Two forms, tried in order:
#   1. Leading assignments, then the thing actually run
#      (`FOO=1 rm -rf /tmp/x`).
#   2. That thing on its own.
#
# Form 1 falls back to form 2 whenever no command follows, so a bare `FOO=1`
# statement still parses exactly as it did before.  Spelling form 1 as an
# optional prefix on form 2 would break that: PEG never retries an optional
# as empty once it has matched.
#
# The prefix hangs off command_name, NOT simple_command: in the conventional
# POSIX position it silently costs nested $(...) decomposition in command_model.
command_name <- assigned_command / command_start

assigned_command <- assignment_prefix command_start

assignment_prefix <- assignment+

# command_start: the word or substitution that is actually EXECUTED.
# The order is free -- only cmd_sub_as_cmd can begin with `$(` or a backtick.
# command_word's !ctrl_keyword gate stops a shell keyword being consumed as a
# command name.
command_start <- cmd_sub_as_cmd / command_word

command_word <- !ctrl_keyword word spacing

# NAME=value and bash's append form NAME+=value.  Quoted strings, escapes, var
# refs and substitutions are part of the value; anything else ends it at the
# first delimiter.
assignment <- assignment_name ("+=" / "=") assignment_value spacing
assignment_name <- identifier
assignment_value <- (quoted_string / escaped_char / tight_cmd_sub / var_ref / !delimiter .)*

# Command substitution inside an assignment value.  Mirrors dollar_paren_sub /
# backtick_sub minus their trailing spacing; keep the three in step.  That
# spacing separates the value from the command word, so consuming it hides the
# command (`FOO=$(id) rm -rf /`).  Do not factor the shared body into a rule --
# it nests .compound_command deeper, which command_model.node_kind classifies on.
tight_cmd_sub <- "$(" spacing compound_command spacing ")" / "`" spacing compound_command spacing "`"

# A command substitution that appears in the command-name position.
# Note: spacing after the `)` is consumed here so the parser advances past it.
cmd_sub_as_cmd <- cmd_substitution spacing

# command_arg: subsequent words / tokens that are NOT the command name.
# No keyword blocking here -- `echo done` must parse with `done` as an argument.
command_arg <- word spacing

# All control-structure keywords that should not appear as bare command names
# at the start of a simple_command.
ctrl_keyword <- (for_kw / while_kw / until_kw / if_kw / then_kw / elif_kw / else_kw / fi_kw / case_kw / in_kw / do_kw / done_kw / esac_kw)

# ============================================================================
# Redirections - explicit file I/O
# ============================================================================

redirection <- append_redirect / output_redirect / heredoc / input_redirect / stderr_redirect / stderr_to_stdout / fd_redirect

# > file (write)
output_redirect <- fd_num? ">" !">" spacing file_path spacing

# << DELIMITER (here-document)
# The heredoc body is removed by the pre-pass (replaced with a sentinel);
# only the introducing line with the sentinel is left in the text the grammar sees.
heredoc <- "<<" "-"? spacing heredoc_delimiter spacing heredoc_content?

heredoc_delimiter <- single_quoted / double_quoted / unquoted_heredoc_word
unquoted_heredoc_word <- [a-zA-Z_] [a-zA-Z0-9_]*

# Here-doc content - inline content on the same line (pre-pass sentinel __HEREDOC_TO_...__
# lives here as an unquoted_word in the surrounding simple_command; the heredoc rule
# captures any inline content that follows the delimiter on the same line).
heredoc_content <- (![\n\r] .)*

# >> file (append write)
append_redirect <- fd_num? ">>" spacing file_path spacing

# < file (read) - must not be << (heredoc) or <( (proc_subst)
input_redirect <- "<" !"<" !"(" spacing file_path spacing

# 2> file (stderr write)
stderr_redirect <- "2>" !">" spacing file_path spacing

# 2>&1 (stderr to stdout merge)
stderr_to_stdout <- "2>&1" spacing

# n>&m or n<&m
fd_redirect <- fd_num (">&" / "<&") fd_num spacing

fd_num <- [0-9]+

# ============================================================================
# Command substitution
# ============================================================================

cmd_substitution <- dollar_paren_sub / backtick_sub

# $(command) - recursively parses the inner command
dollar_paren_sub <- "$(" spacing compound_command spacing ")" spacing

# `command` - recursively parses the inner command
backtick_sub <- "`" spacing compound_command spacing "`" spacing

# ============================================================================
# File paths
# ============================================================================

file_path <- quoted_path / unquoted_path

quoted_path <- single_quoted / double_quoted

unquoted_path <- path_start path_char*

path_start <- "/" / "~" / "." / [a-zA-Z_]
path_char <- [a-zA-Z0-9_./-] / escaped_char
escaped_char <- "\\" .

# ============================================================================
# Words and tokens
# ============================================================================

word <- quoted_string / unquoted_word

quoted_string <- single_quoted / double_quoted / dollar_quoted

# Single-quoted strings: everything up to the closing quote, including newlines.
# In bash, single quotes prevent ALL interpretation; newlines inside are literal.
single_quoted <- "'" single_content "'"
single_content <- (!"'" .)*

# Double-quoted strings: allow escape sequences, variable refs, command subs.
# Newlines inside double quotes are literal (the grammar's `.` already matches them).
double_quoted <- '"' double_content '"'
double_content <- (escaped_char / var_ref / cmd_substitution / !'"' .)*

# $'...' dollar-quoted strings (ANSI-C quoting): \n, \t etc. are escape sequences.
dollar_quoted <- "$'" dollar_content "'"
dollar_content <- (escaped_char / !"'" .)*

# Unquoted words: everything that is not a delimiter.
# Includes escaped chars, variable references, and bare characters.
# `{}` is admitted as a two-character UNIT, ahead of the delimiter check, so it
# can sit inside a word: `echo {}`, `xargs -I{}`, `find ... -exec cat {} +`. A
# LONE `{` or `}` stays a delimiter, which brace_group depends on: its closing
# "}" only matches if compound_command has not swallowed the brace as a word.
unquoted_word <- (escaped_char / var_ref / "{}" / !delimiter .)+

var_ref <- "$" identifier / "${" identifier var_modifier? "}" / "$" special_var

identifier <- [a-zA-Z_] [a-zA-Z0-9_]*
var_modifier <- ":" [-+=?] [^}]*
special_var <- [?$!#@*0-9-]

# ============================================================================
# Reserved words (legacy rule kept for backward compatibility with tree-walker
# code that may reference it; ctrl_keyword is the active gate on command_word)
# ============================================================================

reserved_word <- ("if" / "then" / "else" / "elif" / "fi" / "case" / "esac" / "for" / "while" / "until" / "do" / "done" / "in" / "function") ![a-zA-Z0-9_]

# ============================================================================
# Delimiters and spacing
#
# IMPORTANT: `spacing` is HORIZONTAL whitespace only (spaces and tabs).
# Newlines are NOT in `spacing` -- they are statement separators at the top
# level and are handled explicitly by `line_ws` / `statement_sep`.
# This is the deliberate design choice that makes newline-as-separator work:
# if newlines were in `spacing`, they would be swallowed inside compound_command
# and never reach the program-level statement separator.
# ============================================================================

delimiter <- [ \t\n\r|&;<>(){}$`"']
spacing <- [ \t]*
