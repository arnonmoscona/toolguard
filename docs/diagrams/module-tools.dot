    tools_installer [label="installer", fillcolor="#fce5cd"];
    tools_log_harvest [label="log_harvest", fillcolor="#d9ead3"];
    tools_maintenance [label="maintenance", fillcolor="#cfe2f3"];
    tools_migration_gate [label="migration_gate", fillcolor="#fce5cd"];
    tools_mining [label="mining", fillcolor="#fce5cd"];
    tools_pattern_overlap [label="pattern_overlap", fillcolor="#d9ead3"];
