    tools_redundancy [label="redundancy", fillcolor="#fce5cd"];
    tools_replay [label="replay", fillcolor="#fce5cd"];
    tools_rule_apply [label="rule_apply", fillcolor="#fce5cd"];
    tools_security_audit [label="security_audit", fillcolor="#cfe2f3"];
    tools_self_integrity [label="self_integrity", fillcolor="#d9ead3"];
    tools_self_permission [label="self_permission", fillcolor="#d9ead3"];
    tools_sorters [label="sorters", fillcolor="#eeeeee"];
    tools_takeover_audit [label="takeover_audit", fillcolor="#d9ead3"];
    tools_transcript_harvest [label="transcript_harvest", fillcolor="#fce5cd"];
    tools_uninstall_readiness [label="uninstall_readiness", fillcolor="#d9ead3"];
    tools_update_skills [label="update_skills", fillcolor="#cfe2f3"];
    tools_working_tree [label="working_tree", fillcolor="#d9ead3"];

    tools_annotate -> tools_clarity;
    tools_clarity -> tools_config_access;
    tools_clarity -> tools_pattern_overlap;
    tools_consolidate -> tools_config_access;
    tools_consolidate -> tools_pattern_overlap;
    tools_consolidate -> tools_replay;
    tools_corpus -> tools_project_root;
    tools_corpus -> tools_transcript_harvest;
    tools_danger -> tools_config_access;
    tools_edit_proposal -> tools_config_access;
    tools_environment_audit -> tools_danger;
    tools_hierarchy -> tools_redundancy;
    tools_installer -> tools_recommended_protections;
    tools_installer -> tools_self_integrity;
    tools_installer -> tools_self_permission;
    tools_installer -> tools_uninstall_readiness;
    tools_maintenance -> tools_annotate;
    tools_maintenance -> tools_corpus;
    tools_maintenance -> tools_decision_ledger;
    tools_maintenance -> tools_edit_proposal;
    tools_maintenance -> tools_hierarchy;
    tools_maintenance -> tools_migration_gate;
    tools_maintenance -> tools_mining;
    tools_maintenance -> tools_rule_apply;
    tools_migration_gate -> tools_project_root;
