digraph tools {
    rankdir=TB;
    newrank=true;
    splines=ortho;
    nodesep=0.3;
    ranksep=0.7;
    node [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=10];
    edge [color="#666666", arrowsize=0.6];
    tools [label="tools", fillcolor="#eeeeee"];
    tools_annotate [label="annotate", fillcolor="#fce5cd"];
    tools_clarity [label="clarity", fillcolor="#fce5cd"];
    tools_config_access [label="config_access", fillcolor="#d9ead3"];
