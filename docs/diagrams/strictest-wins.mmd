---
title: Combining leaf verdicts - strictest wins, deny > ask > allow
---
flowchart TD
    LEAVES["the per-leaf UnitVerdicts of one compound command"]
    Q1{"any leaf<br/>'deny'?"}
    Q2{"any leaf<br/>'ask'?"}
    Q3{"any leaf<br/>'allow'?"}
    DENY["<b>deny</b><br/>the first denied leaf supplies<br/>the reason and additionalContext"]
    ASK["<b>ask</b><br/>the first asking leaf supplies them"]
    ALLOW["<b>allow</b><br/>every leaf allowed; their contexts<br/>are accumulated, not replaced"]
    EMPTY["<b>deny</b> - an empty leaf list fails closed.<br/>On the live path resolve.py intercepts first, with<br/>'No valid commands found in command line'"]
    NOTE["Position in the command line does not change the verdict,<br/>only which leaf's wording is reported.<br/>The parse-failure ASK floor runs after this step,<br/>and never weakens a deny."]

    LEAVES --> Q1
    Q1 -->|"yes"| DENY
    Q1 -->|"no"| Q2
    Q2 -->|"yes"| ASK
    Q2 -->|"no"| Q3
    Q3 -->|"yes"| ALLOW
    Q3 -->|"no"| EMPTY

    classDef safe fill:#e8f5e9,stroke:#3f8f47,color:#12331a
    classDef clamp fill:#fff3e0,stroke:#c07a1e,color:#3a2708
    classDef note fill:#ffffff,stroke:#999,stroke-dasharray:4 3,color:#333
    class ALLOW safe
    class DENY,ASK,EMPTY clamp
    class NOTE note
